[
  { "name": "simple output", "content": "<p>{{ invoiceNumber }}</p>", "expect": { "ok": true } },
  { "name": "nested output", "content": "<p>{{ customerAddress }}</p>", "expect": { "ok": true } },
  { "name": "for loop", "content": "{% for item in items %}<td>{{ item.description }}</td>{% endfor %}", "expect": { "ok": true } },
  { "name": "loop metadata", "content": "{% for item in items %}{{ forloop.index }}{{ forloop.first }}{{ forloop.last }}{{ forloop.length }}{% endfor %}", "expect": { "ok": true } },
  { "name": "if elsif else", "content": "{% if dueOn %}a{% elsif notes %}b{% else %}c{% endif %}", "expect": { "ok": true } },
  { "name": "unless", "content": "{% unless notes %}none{% endunless %}", "expect": { "ok": true } },
  { "name": "assign", "content": "{% assign ref = invoiceNumber %}{{ ref }}", "expect": { "ok": true } },
  { "name": "raw block", "content": "{% raw %}{{ not_a_token }}{% endraw %}", "expect": { "ok": true } },
  { "name": "comment block", "content": "{% comment %} ignored {{ nope }} {% endcomment %}{{ invoiceNumber }}", "expect": { "ok": true } },
  { "name": "whitespace control", "content": "{%- for item in items -%}{{- item.description -}}{%- endfor -%}", "expect": { "ok": true } },
  { "name": "filters allow-list", "content": "{{ invoiceNumber | upcase }}{{ customerName | escape }}{{ notes | default: 'x' }}", "expect": { "ok": true } },
  { "name": "css transparency", "content": "<style>@page{size:A4;margin:20mm}@media print{body{color:#000}}@font-face{font-family:x;src:url(./assets/f.ttf)}</style>", "expect": { "ok": true } },
  { "name": "unknown token", "content": "<p>{{ invoiceDate }}</p>", "expect": { "code": "UNKNOWN_TOKEN" } },
  { "name": "unknown token near miss", "content": "<p>{{ issuedOnn }}</p>", "expect": { "code": "UNKNOWN_TOKEN", "suggestion": "issuedOn" } },
  { "name": "collection outside loop", "content": "{{ item.description }}", "expect": { "code": "TYPE_MISMATCH" } },
  { "name": "collection output", "content": "{{ items }}", "expect": { "code": "TYPE_MISMATCH" } },
  { "name": "capture rejected", "content": "{% capture x %}a{% endcapture %}", "expect": { "code": "TAG_NOT_ALLOWED" } },
  { "name": "include rejected", "content": "{% include 'x' %}", "expect": { "code": "TAG_NOT_ALLOWED" } },
  { "name": "case rejected", "content": "{% case invoiceNumber %}{% when 'a' %}{% endcase %}", "expect": { "code": "TAG_NOT_ALLOWED" } },
  { "name": "arithmetic filter rejected", "content": "{{ total | times: 2 }}", "expect": { "code": "FILTER_NOT_ALLOWED" } },
  { "name": "date filter rejected", "content": "{{ issuedOn | date: '%Y' }}", "expect": { "code": "FILTER_NOT_ALLOWED" } },
  { "name": "script rejected", "content": "<script>alert(1)</script>", "expect": { "code": "UNSAFE_MARKUP" } },
  { "name": "inline handler rejected", "content": "<img src=\"./assets/a.png\" onerror=\"x()\">", "expect": { "code": "UNSAFE_MARKUP" } },
  { "name": "iframe rejected", "content": "<iframe src=\"./assets/a.html\"></iframe>", "expect": { "code": "UNSAFE_MARKUP" } },
  { "name": "javascript url rejected", "content": "<a href=\"javascript:alert(1)\">x</a>", "expect": { "code": "UNSAFE_MARKUP" } },
  { "name": "remote css rejected", "content": "<style>.a{background:url(https://x/y.png)}</style>", "expect": { "code": "EXTERNAL_REFERENCE_REJECTED" } },
  { "name": "remote import rejected", "content": "<style>@import url('https://x/y.css');</style>", "expect": { "code": "EXTERNAL_REFERENCE_REJECTED" } },
  { "name": "absolute path rejected", "content": "<img src=\"/etc/passwd\">", "expect": { "code": "EXTERNAL_REFERENCE_REJECTED" } },
  { "name": "traversal rejected", "content": "<img src=\"../../secrets.txt\">", "expect": { "code": "EXTERNAL_REFERENCE_REJECTED" } },
  { "name": "data uri rejected", "content": "<img src=\"data:image/png;base64,AAAA\">", "expect": { "code": "EXTERNAL_REFERENCE_REJECTED" } },
  { "name": "bracket access rejected", "content": "{{ items[0].description }}", "expect": { "code": "TEMPLATE_SYNTAX_ERROR" } },
  { "name": "unclosed section", "content": "{% for item in items %}x", "expect": { "code": "UNCLOSED_SECTION" } },
  { "name": "unclosed output", "content": "<p>{{ invoiceNumber", "expect": { "code": "UNCLOSED_OUTPUT" } },
  { "name": "nested loops", "content": "{% for item in items %}{% for part in item.parts %}{{ part.sku }}{% endfor %}{% endfor %}", "expect": { "ok": true } },
  { "name": "hardcoded page number warns", "content": "<div class=\"pageNumber\"></div>", "expect": { "ok": true, "warning": "HARDCODED_PAGE_NUMBER" } },
  { "name": "font face passthrough", "content": "<style>@font-face{font-family:x;src:url(./assets/f.ttf) format('truetype')}</style>", "expect": { "ok": true } }
]
